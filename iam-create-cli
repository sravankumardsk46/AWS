# =========================================
# 1. INSTALL AWS CLI (Ubuntu EC2)
# =========================================
sudo apt update
sudo apt install unzip curl -y
curl "https://awscli.amazonaws.com/awscli-exe-linux-x86_64.zip" -o "awscliv2.zip"
unzip awscliv2.zip
sudo ./aws/install
aws --version

# =========================================
# 2. CONFIGURE AWS CLI
# =========================================
aws configure
# Enter:
# Access Key
# Secret Key
# Region (ap-south-1)
# Output (json)

# =========================================
# 3. IAM - CREATE GROUP
# =========================================
aws iam create-group --group-name devops-team

# Attach policy (S3 full access)
aws iam attach-group-policy \
--group-name devops-team \
--policy-arn arn:aws:iam::aws:policy/AmazonS3FullAccess

# =========================================
# 4. IAM - CREATE USER
# =========================================
aws iam create-user --user-name devops-user

# Add user to group
aws iam add-user-to-group \
--user-name devops-user \
--group-name devops-team

# =========================================
# 5. LOGIN + ACCESS KEY
# =========================================
aws iam create-login-profile \
--user-name devops-user \
--password 'Password@123' \
--password-reset-required

aws iam create-access-key --user-name devops-user

# =========================================
# 6. VERIFY IAM
# =========================================
aws iam list-users
aws iam list-groups
aws iam list-attached-group-policies --group-name devops-team

# =========================================
# 7. S3 - CREATE BUCKET
# =========================================
aws s3 mb s3://my-devops-bucket-12345

# List buckets
aws s3 ls

# =========================================
# 8. EC2 → S3 FILE UPLOAD
# =========================================
echo "Hello DevOps" > file.txt

aws s3 cp file.txt s3://my-devops-bucket-12345/

# Upload folder
mkdir mydata
echo "test1" > mydata/a.txt
echo "test2" > mydata/b.txt

aws s3 cp mydata/ s3://my-devops-bucket-12345/ --recursive

# =========================================
# 9. DOWNLOAD FROM S3
# =========================================
aws s3 cp s3://my-devops-bucket-12345/file.txt .

# =========================================
# 10. LIST S3 FILES
# =========================================
aws s3 ls s3://my-devops-bucket-12345/

# =========================================
# 11. DELETE FILE FROM S3
# =========================================
aws s3 rm s3://my-devops-bucket-12345/file.txt

# =========================================
# 12. ENV VARIABLES (OPTIONAL)
# =========================================
export AWS_ACCESS_KEY_ID=YOUR_KEY
export AWS_SECRET_ACCESS_KEY=YOUR_SECRET
export AWS_DEFAULT_REGION=ap-south-1

# =========================================
# 13. REMOVE ENV VARIABLES
# =========================================
unset AWS_ACCESS_KEY_ID
unset AWS_SECRET_ACCESS_KEY
unset AWS_DEFAULT_REGION

# =========================================
# 14. MULTI PROFILE
# =========================================
aws configure --profile dev
aws s3 ls --profile dev

# =========================================
# 15. ACCESS KEY MANAGEMENT
# =========================================
aws iam list-access-keys --user-name devops-user

aws iam delete-access-key \
--user-name devops-user \
--access-key-id ACCESS_KEY_ID

# =========================================
# 16. CLEANUP
# =========================================
aws s3 rb s3://my-devops-bucket-12345 --force

aws iam delete-user --user-name devops-user
aws iam delete-group --group-name devops-team
